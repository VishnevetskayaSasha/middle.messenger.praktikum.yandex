<main class="auth">
  <div class="auth__wrapper">
     {{{ Heading
      text = "Регистрация"
     }}}

    <form action="" method="post" class="auth__form">
      {{{ Input
        label = "Почта"
        type = "text"
        name = "email"
      }}}

      {{{ Input
        label = "Логин"
        type = "text"
        name = "login"
      }}}

      {{{ Input
        label = "Имя"
        type = "text"
        name = "first_name"
      }}}

      {{{ Input
        label = "Фамилия"
        type = "text"
        name = "second_name"
      }}}

      {{{ Input
        label = "Телефон"
        type = "tel"
        name = "phone"
      }}}

      {{{ Input
        label = "Пароль"
        type = "password"
        name = "password"
      }}}

      {{{ Input
        label = "Пароль (ещё раз)"
        type = "password"
        name = "confirm_password"
      }}}
      <div class="auth__button-wrapper auth__button-wrapper_registration">
        {{{ Button
          label = "Зарегистрироваться"
          modifier = "registration"
          type = "submit"
        }}}
      </div>

      {{{ Link
        modifier = "default"
        href = "/messenger"
        text = "Войти"
      }}}
    </form>
  </div>
</main>
