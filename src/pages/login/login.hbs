<main class="auth">
  <div class="auth__wrapper">
     {{{ Heading
      text = "Вход"
     }}}

    <form action="" method="post" class="auth__form">
      {{{ Input
        label="Логин"
        type="text"
        name="login"
      }}}
      
      {{{ Input
        label="Пароль"
        type="password"
        name="password"
      }}}

      <div class="auth__button-wrapper auth__button-wrapper_login">
        {{{ Button
          label = "Авторизоваться"
          modifier = "login"
          type = "submit"
        }}}
      </div>

      {{{ Link
        modifier = "default"
        href = "#register"
        text = "Нет аккаунта?"
      }}}
    </form>
  </div>
</main>
