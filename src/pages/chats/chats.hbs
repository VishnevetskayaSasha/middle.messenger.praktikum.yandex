<main class="chats">
  <div class="chats__wrapper">
    <div class="chats__utils-wrapper">
      {{{ Button
        type = "button"
        label = "+ Новый чат"
        modifier = "create-chat"
        ref = "createChatButton"
      }}}

      <div class="chats__profile-wrapper">
        {{{ Link
          modifier = "profile"
          href = "/settings"
          text = "Профиль"
        }}}
        <svg width="6" height="9" viewBox="0 0 6 9" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.353554 8.35355L4.35355 4.35355L0.353554 0.353546" stroke="#999999"/>
        </svg>
      </div>
    </div>
    <form class="search">
      <input
        type="search"
        name="search"
        class="search__input"
        placeholder="Поиск"
      >
      <img
        class="search__ico"
        src="/img/magnifier.svg"
        alt="Поиск"
      >
    </form>

    <aside class="sidebar">
      {{{ FormError
        text = formError
      }}}
      <nav>
        <ul class="chat-list">
          {{#each chats}}
            {{{ ChatItem
              id = id
              name = name
              unreadCount = unreadCount
              lastMessage = lastMessage
              isSelected = isSelected
              onClick = onClick
            }}}
          {{/each}}
        </ul>
      </nav>
    </aside>
  </div>
  <div class="chats__content">
    {{#unless hasChats}}
      <div class="chats__empty-wrapper">
        <p class="chats__empty">
          У вас пока нет чатов
        </p>
      </div>
    {{/unless}}

    {{#if hasChats}}
      {{#unless activeChatId}}
        <div class="chats__empty-wrapper">
          <p class="chats__empty">
            Выберите чат, чтобы отправить сообщение
          </p>
        </div>
      {{/unless}}

      {{#if activeChatId}}
        <div class="chats__conversation">
          {{{ ChatHeader
            title = activeChatTitle
            avatar = activeChatAvatar
          }}}

          {{{ ChatMessages
            hasMessages = false
          }}}

          {{{ ChatFooter
            onSend = onSendMessage
          }}}
      {{/if}}
    {{/if}}
  </div>
  <div class="chats__modal-root" ref="modalRoot"></div>
</main>
