<div class="modal">
  <div class="modal__overlay"></div>

  <div class="modal__content">
    {{{ Button
      type = "button"
      label = "x"
      modifier = "modal-close"
      ref = "closeButton"
    }}}

    <h2 class="modal__title">
      {{title}}
    </h2>

    <div class="modal__body"></div>
  </div>
</div>
