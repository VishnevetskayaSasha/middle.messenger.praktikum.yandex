<header class="chat-header">
  <div class="chat-header__info">
    <img
      class="chat-header__avatar"
      src="{{#if avatar}}{{avatar}}{{else}}/img/avatar.jpg{{/if}}"
      alt="Аватар"
    >

    <h2 class="chat-header__title">
      {{title}}
    </h2>
  </div>

  <div
    class="chat-header__menu-wrapper"
    ref="menuWrapper"
  >
    {{{ Button
      type="button"
      label="⋮"
      modifier="chat-menu"
      ref="menuButton"
    }}}

    {{#if isMenuOpen}}
      <div class="chat-header__menu">
        <button
          class="chat-header__menu-item"
          type="button"
          ref="addUserButton"
        >
          Добавить пользователя
        </button>

        <button
          class="chat-header__menu-item"
          type="button"
          ref="removeUserButton"
        >
          Удалить пользователя
        </button>
      </div>
    {{/if}}
  </div>
</header>
