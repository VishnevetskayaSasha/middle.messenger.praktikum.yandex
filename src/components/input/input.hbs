<div class="input">
  <label class="input__label" for="{{name}}">{{label}}</label>

  <input
    class="input__field"
    id="{{name}}"
    type="{{type}}"
    name="{{name}}"
    placeholder="{{label}}"
    {{#if autocomplete}}autocomplete="{{autocomplete}}"{{/if}}
  />

  <span class="input__error"></span>
</div>
